# ---- Haq configuration ----
# Leave everything blank to run the OFFLINE DEMO model (no key needed).

# Your Cline API key (Cline account → API keys). Uses your Cline credits.
CLINE_API_KEY=

# Provider + model for the caseworker agent (any provider the Cline SDK supports).
# Cline usage billing:
HAQ_PROVIDER=cline
HAQ_MODEL=anthropic/claude-sonnet-5
# ClinePass (open-weight models on your ClinePass plan) — uncomment to use:
# HAQ_PROVIDER=cline-pass
# HAQ_MODEL=cline-pass/glm-5.3
# Fully local and private with Ollama (no key):
# HAQ_PROVIDER=ollama
# HAQ_MODEL=qwen3:8b

# Force the offline demo model even if a key is set (useful for stage demos without Wi-Fi)
# HAQ_MODE=demo

PORT=3000
